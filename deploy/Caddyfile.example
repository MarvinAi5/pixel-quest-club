# Template ONLY. The operator must choose two unused ports before installing.
# Tunnel -> Caddy 8792 -> /api backend 8793, static /var/www/pixel-quest-club.
# Merge appropriately with existing Caddy management; do not replace other sites.
{
    admin off
    auto_https off
}
http://:8792 {
    encode gzip zstd
    header X-Content-Type-Options nosniff
    header Referrer-Policy same-origin
    header Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    handle /api/* {
        reverse_proxy 127.0.0.1:8793
    }
    handle {
        root * /var/www/pixel-quest-club
        @versioned path_regexp versioned -[a-f0-9]{12}\.(css|js|json|webp|jpg|svg|zip)$
        header Cache-Control "no-cache"
        header @versioned Cache-Control "public, max-age=31536000, immutable"
        try_files {path} {path}.html
        file_server
    }
    handle_errors {
        @404 expression `{err.status_code} == 404`
        handle @404 {
            root * /var/www/pixel-quest-club
            rewrite * /404.html
            file_server
        }
    }
}
