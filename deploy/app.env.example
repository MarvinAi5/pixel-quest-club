# Copy privately to /var/lib/pixel-quest-club/app.env, mode 600.
# The operator must choose a free port. Do not reuse a port owned by another site.
PORT=8793
PQC_SECURE_COOKIES=1
PQC_PARENT_SIGNUP=1
# Set a private setup code BEFORE making this public.
PQC_PARENT_INVITE=
# Set to 1 to allow children to create their own saved accounts.
# Parent registration can stay closed; existing parents can link accounts.
PQC_OPEN_CHILD_SIGNUP=0
PQC_MAX_ACCOUNTS=250

# Family activity summaries use local dates; week starts Monday.
PQC_TIMEZONE=America/Denver
# Set privately to the EXISTING owner's parent username. Empty hides site traffic.
PQC_OWNER_USERNAME=
# Optional Cloudflare Zone Analytics read-only token scoped to this zone only.
# Never put real IDs/tokens in the repository or browser code.
PQC_CF_ZONE_ID=
PQC_CF_ANALYTICS_TOKEN=
